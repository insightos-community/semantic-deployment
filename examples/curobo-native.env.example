# Copy to the installation directory, update paths, and source before starting.
export SEMANTIC_ROOT=/opt/semantic
export SEMANTIC_BEHAVIOR_PYTHON=/opt/semantic/envs/native/bin/python
export SEMANTIC_BEHAVIOR_LIB_DIR=/opt/conda/envs/behavior/lib
export OMNIGIBSON_DATA_PATH=/data/BEHAVIOR-1K/datasets
export SEMANTIC_BEHAVIOR_GPU=0
# Positive episode step budget, including idle/planning steps. Restart Runtime after editing.
export SEMANTIC_BEHAVIOR_MAX_STEPS=100000
export SEMANTIC_RUNTIME_PORT=18100
export SEMANTIC_RUNTIME_HOST=127.0.0.1
